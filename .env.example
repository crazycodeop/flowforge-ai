# Environment Configuration for FlowForge AI

# App Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="FlowForge AI"
API_V1_STR=/api/v1

# Security & Auth
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
# For local host development with user cluster:
DATABASE_URL=postgresql+psycopg2://vakildesk@localhost:5433/flowforge
TEST_DATABASE_URL=postgresql+psycopg2://vakildesk@localhost:5433/flowforge_test
# For Docker Compose:
# DATABASE_URL=postgresql+psycopg2://flowforge:flowforge@postgres:5432/flowforge

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Provider Configuration (Optional at boot; deterministic mock used if absent)
AI_PROVIDER=mock
AI_MODEL=mock-model-v1
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3

# Operational Limits
MAX_WORKFLOW_NODES=50
MAX_GRAPH_DEPTH=20
MAX_EXECUTION_TIMEOUT_SECONDS=3600
WORKER_CONCURRENCY=4
