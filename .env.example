# Environment Configuration for FlowForge AI
# Copy this file to .env and configure credentials for your environment.

# App Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="FlowForge AI"
API_V1_STR=/api/v1

# Security & Auth
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL 15+)
# Cloud (e.g. Supabase Pooler):
DATABASE_URL=postgresql+psycopg2://postgres.<user>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/flowforge

# Redis & Celery Message Broker
# Cloud (e.g. Upstash Redis with TLS):
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379/0
CELERY_BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379/0
CELERY_RESULT_BACKEND=rediss://default:<password>@<host>.upstash.io:6379/0
# Local Redis:
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider Configuration
# Supported providers: groq, openai, ollama, mock
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_API_KEY=gsk_your_groq_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=3

# Operational Safeguards
MAX_WORKFLOW_NODES=50
MAX_GRAPH_DEPTH=20
MAX_EXECUTION_TIMEOUT_SECONDS=3600
WORKER_CONCURRENCY=2
